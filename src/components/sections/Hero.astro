---
/** Hero B, "white sheet on a black wall": the name in type alone on a chamfered
    surface-inverse sheet, with one crimson button. */
import { publicUrl } from '../../lib/site';
import Icon from '../Icon.astro';

interface Props {
  name: string;
  roles: string[];
  lead: string;
  location: string;
  resume: string;
}
const { name, roles, lead, location, resume } = Astro.props;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="shell">
    <div class="hero__sheet">
      {/* The eyebrow's crimson rule becomes a crimson map pin here. */}
      <div class="ch-heading">
        <p class="ch-heading__eyebrow hero__where"><Icon name="pin" />{location}</p>
      </div>
      <h1 class="display-1 hero__name" id="hero-name">{name}</h1>
      <p class="hero__role">
        {
          roles.map((role, i) => (
            <Fragment>
              {i > 0 && <span class="sep"> · </span>}
              <span class="role">{role}</span>
            </Fragment>
          ))
        }
      </p>
      <p class="lead hero__lead">{lead}</p>
      <div class="hero__cta">
        <a class="ch-btn ch-btn--primary ch-btn--lg ch-btn--skew" href="#contact"><span>Contact me</span></a>
        <a class="ch-btn ch-btn--lg" href={publicUrl(resume)} target="_blank" rel="noopener">
          Download the résumé <Icon name="external" /><span class="visually-hidden"> (PDF, opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>
