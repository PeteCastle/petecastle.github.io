---
import { render, type CollectionEntry } from 'astro:content';
import { pad2 } from '../../lib/data';
import ExternalLink from '../ExternalLink.astro';
import MoreButton from '../MoreButton.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  jobs: CollectionEntry<'jobs'>[];
  index: number;
}
const { jobs, index } = Astro.props;

/** Roles shown before the section's "View more" (jobs are in their `order`). */
const ROLES_SHOWN = 3;
/** Bullets shown before each role's "View more"; entries list their strongest points first. */
const SHOWN = 2;

// Each entry's body is one Markdown list; split its rendered items so the first
// SHOWN stay visible. A body that is not a plain list renders whole.
const rows = await Promise.all(
  jobs.map(async (job) => {
    const html = job.rendered?.html ?? '';
    const bullets = [...html.matchAll(/<li>([\s\S]*?)<\/li>/g)].map((m) => m[1]);
    return { job, bullets, Content: bullets.length ? null : (await render(job)).Content };
  }),
);
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="shell">
    <SectionHeading
      class="reveal"
      id="experience-title"
      eyebrow={`Experience // ${pad2(index)} · ${jobs.length} roles`}
      title="Experience"
    />
    <div class="xp" id="xp-list" data-collapsible>
      {
        rows.map(({ job, bullets, Content }, n) => (
          <article class:list={['xp__row', 'reveal', { 'more-extra': n >= ROLES_SHOWN }]}>
            <div class="xp__rec">
              <h3 class="subtitle">{job.data.title}</h3>
              <p>
                <ExternalLink href={job.data.url}>{job.data.company}</ExternalLink>
              </p>
              <p class="caption">
                {job.data.location} · {job.data.range}
              </p>
              {(job.data.end === null || job.data.type !== 'Professional') && (
                <div class="tags">
                  {job.data.end === null && <span class="ch-tag ch-tag--subtle ch-tag--ok">Current</span>}
                  {job.data.type !== 'Professional' && <span class="ch-tag">{job.data.type}</span>}
                </div>
              )}
            </div>
            <div class="xp__list">
              {Content ? (
                <Content />
              ) : (
                <ul id={`xp-${job.id}`} data-collapsible>
                  {bullets.map((b, i) => (
                    <li class:list={[{ 'more-extra': i >= SHOWN }]} set:html={b} />
                  ))}
                </ul>
              )}
              {bullets.length > SHOWN && (
                <MoreButton controls={`xp-${job.id}`} context={`${job.data.title}, ${job.data.companyShort}`} />
              )}
            </div>
          </article>
        ))
      }
    </div>
    {jobs.length > ROLES_SHOWN && <MoreButton controls="xp-list" context="experience" />}
  </div>
</section>
