---
/** The page's one surface-deep band. */
interface Props {
  label: string;
  text: string;
  caption: string;
}
const { label, text, caption } = Astro.props;
---

<section class="why" id="why" aria-label={label}>
  <div class="shell reveal">
    <p class="label">{label}</p>
    <blockquote class="display-3"><p>{text}</p></blockquote>
    <p class="caption">{caption}</p>
  </div>
</section>
