---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { pad2 } from '../../lib/data';
import { shortDate } from '../../lib/site';
import { words } from '../../lib/words';
import ExternalLink from '../ExternalLink.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  education: CollectionEntry<'education'>[];
  certifications: CollectionEntry<'certifications'>[];
  index: number;
}
const { education, certifications, index } = Astro.props;

// Certificate scans ship as WebP copies (at most 1600px wide), never the originals.
const certs = await Promise.all(
  certifications.map(async (cert) => {
    const img = cert.data.image;
    const copy = await getImage({ src: img, width: Math.min(1600, img.width), format: 'webp', quality: 82 });
    return { cert, href: copy.src };
  }),
);
const degrees = education.filter((e) => e.data.degree.startsWith('MS') || e.data.degree.startsWith('BS')).length;
const summa = education.some((e) => /summa cum laude/i.test(e.data.honours));
---

<section class="section section--alt" id="credentials" aria-labelledby="credentials-title">
  <div class="shell">
    <SectionHeading
      class="reveal"
      id="credentials-title"
      eyebrow={`Credentials // ${pad2(index)}`}
      title="Degrees and certifications"
      lead={`${words(degrees, true)} degrees${summa ? ', one summa cum laude,' : ''} and ${words(certifications.length)} data certifications, newest first.`}
    />
    <div class="g12">
      <div class="edu reveal">
        <h3 class="label">Education</h3>
        {
          education.map((e) => (
            <div class="edu__item">
              <h4 class="subtitle">
                {e.data.degree}, {e.data.year}
              </h4>
              <p class="school">{e.data.school}</p>
              <p class:list={['hon', { 'hon--gold': e.data.gold }]}>{e.data.honours}</p>
            </div>
          ))
        }
      </div>
      <div class="certs reveal">
        <h3 class="label">Certifications</h3>
        {
          certs.map(({ cert, href }) => (
            <div class="cert">
              <p class="cert__date">
                <time datetime={cert.data.date.toISOString().slice(0, 10)}>{shortDate(cert.data.date)}</time>
              </p>
              <h4 class="cert__name">{cert.data.name}</h4>
              <p class="cert__issuer">{cert.data.issuer}</p>
              <p class="caption">{cert.data.skills.join(' · ')}</p>
              <p class="cert__links body-sm">
                <ExternalLink class="ch-link ch-link--quiet" href={href} icon={false} hint="image, opens in a new tab">
                  View the certificate
                </ExternalLink>
                {cert.data.credentialUrl && (
                  <ExternalLink class="ch-link ch-link--quiet" href={cert.data.credentialUrl}>
                    Verify
                  </ExternalLink>
                )}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
