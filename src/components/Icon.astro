---
/** Linework glyphs from the design system: 2px square-capped strokes on a 24 grid. */
interface Props {
  name: 'external' | 'arrow-right' | 'arrow-left' | 'menu' | 'close';
  class?: string;
}
const { name, class: className } = Astro.props;
const PATHS: Record<Props['name'], string> = {
  external: 'M14 5h5v5M19 5l-8 8M19 14v5H5V5h5',
  'arrow-right': 'M4 12h15M13 6l6 6-6 6',
  'arrow-left': 'M20 12H5M11 6l-6 6 6 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
};
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={PATHS[name]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
</svg>
