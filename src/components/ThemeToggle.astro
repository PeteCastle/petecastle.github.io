---
/** Night is the default; this switch turns Day on. Hidden until the script runs. */
---

<label class="ch-switch theme-switch" for="theme-switch">
  <input type="checkbox" id="theme-switch" role="switch" aria-checked="false" autocomplete="off" />
  <span class="label">Day</span>
</label>

<script>
  import '../scripts/theme-toggle';
</script>
