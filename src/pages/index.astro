---
import { getImage } from 'astro:assets';
import About from '../components/sections/About.astro';
import Certifications from '../components/sections/Certifications.astro';
import Contact from '../components/sections/Contact.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Hero from '../components/sections/Hero.astro';
import Skills from '../components/sections/Skills.astro';
import Work from '../components/sections/Work.astro';
import headshot from '../assets/photos/headshot-square.jpg';
import Base from '../layouts/Base.astro';
import {
  getCatalogue,
  getCertifications,
  getEducation,
  getFeatured,
  getJobs,
  getProfile,
  getSkills,
} from '../lib/data';
import { SITE_URL, absolute } from '../lib/site';

const [profile, jobs, featured, skills, certifications, education, catalogue] = await Promise.all([
  getProfile(),
  getJobs(),
  getFeatured(),
  getSkills(),
  getCertifications(),
  getEducation(),
  getCatalogue(),
]);
const p = profile.data;
const photo = await getImage({ src: headshot, width: 640, format: 'jpg' });

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: p.name,
  alternateName: p.nickname,
  url: `${SITE_URL}/`,
  image: absolute(photo.src),
  description: p.seo.description,
  jobTitle: p.roles,
  worksFor: jobs
    .filter((j) => j.data.end === null)
    .map((j) => ({ '@type': 'Organization', name: j.data.company, url: j.data.url })),
  alumniOf: education
    .filter((e) => e.data.level === 'degree')
    .map((e) => ({ '@type': 'CollegeOrUniversity', name: e.data.school })),
  address: { '@type': 'PostalAddress', addressLocality: 'Manila', addressCountry: 'PH' },
  email: `mailto:${p.email}`,
  knowsAbout: p.interests,
  sameAs: p.social.map((s) => s.url),
};
---

<Base path="/" jsonLd={[person]}>
  <Hero name={p.name} roles={p.roles} lead={p.lead} location={p.location} resume={p.resume} />
  <About profile={profile} index={1} />
  <Education education={education} index={2} />
  <Experience jobs={jobs} index={3} />
  <Work featured={featured} total={catalogue.total} index={4} />
  <Skills skills={skills} index={5} />
  <Certifications certifications={certifications} index={6} />
  <Contact profile={profile} index={7} />
</Base>
